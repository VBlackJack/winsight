<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- CA1822: instance services are wired through DI; they are intentionally not static. -->
    <NoWarn>$(NoWarn);CA1822</NoWarn>

    <Authors>Julien Bombled</Authors>
    <Company>Julien Bombled</Company>
    <Copyright>Copyright 2026 Julien Bombled</Copyright>
    <Product>Winsight</Product>
    <Version>0.6.0</Version>

    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/VBlackJack/winsight</PackageProjectUrl>
    <RepositoryUrl>https://github.com/VBlackJack/winsight</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <NeutralLanguage>en-US</NeutralLanguage>

    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

</Project>
