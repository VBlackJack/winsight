<Window x:Class="Winsight.Samples.SimpleCounter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Winsight.Samples.SimpleCounter.ViewModels"
        Title="Winsight Sample - Counter"
        Width="420" Height="280"
        WindowStartupLocation="CenterScreen"
        AutomationProperties.AutomationId="MainWindow">
    <Window.DataContext>
        <vm:CounterViewModel />
    </Window.DataContext>
    <Grid Margin="32">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="{Binding Count, StringFormat='Count: {0}'}"
                       FontSize="48"
                       HorizontalAlignment="Center"
                       AutomationProperties.AutomationId="CountLabel" />
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,24,0,0">
                <Button Content="Increment"
                        Padding="20,10"
                        Margin="0,0,12,0"
                        AutomationProperties.AutomationId="IncrementButton"
                        Command="{Binding IncrementCommand}" />
                <Button Content="Reset"
                        Padding="20,10"
                        AutomationProperties.AutomationId="ResetButton"
                        Command="{Binding ResetCommand}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
