<Window x:Class="Winsight.Samples.SimpleCounter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Winsight.Samples.SimpleCounter.ViewModels"
        Title="Winsight Sample - Counter"
        Width="420" Height="520"
        WindowStartupLocation="CenterScreen"
        AutomationProperties.AutomationId="MainWindow">
    <Window.InputBindings>
        <KeyBinding Key="N"
                    Modifiers="Control+Shift"
                    Command="{Binding ShortcutNoteCommand}" />
    </Window.InputBindings>
    <Window.DataContext>
        <vm:CounterViewModel />
    </Window.DataContext>
    <Grid Margin="32">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="{Binding Count, StringFormat='Count: {0}'}"
                       FontSize="48"
                       HorizontalAlignment="Center"
                       AutomationProperties.AutomationId="CountLabel" />
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,24,0,0">
                <Button Content="Increment"
                        Padding="20,10"
                        Margin="0,0,12,0"
                        AutomationProperties.AutomationId="IncrementButton"
                        ToolTip="Increment counter by one"
                        ToolTipService.InitialShowDelay="0"
                        ToolTipService.ShowDuration="60000"
                        Command="{Binding IncrementCommand}" />
                <Button Content="Reset"
                        Padding="20,10"
                        AutomationProperties.AutomationId="ResetButton"
                        Command="{Binding ResetCommand}" />
            </StackPanel>
            <ComboBox Margin="0,24,0,0"
                      Width="160"
                      ItemsSource="{Binding Options}"
                      SelectedItem="{Binding SelectedOption}"
                      AutomationProperties.AutomationId="OptionSelector" />
            <CheckBox Content="Enable feature"
                      Margin="0,16,0,0"
                      HorizontalAlignment="Center"
                      IsChecked="{Binding IsFeatureEnabled}"
                      AutomationProperties.AutomationId="FeatureToggle" />
            <Button Content="Open Dialog"
                    Padding="20,10"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Center"
                    AutomationProperties.AutomationId="OpenDialogButton"
                    Click="OnOpenDialogClick" />
            <Button Padding="20,10"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Center"
                    AutomationProperties.AutomationId="SemanticContainer"
                    AutomationProperties.Name="Winsight.Samples.SimpleCounter.ViewModels.SemanticAction">
                <TextBlock Text="Semantic Child Label" />
            </Button>
            <TextBlock Text="{Binding LastNote}"
                       Margin="0,16,0,0"
                       HorizontalAlignment="Center"
                       AutomationProperties.AutomationId="LastNoteLabel" />
        </StackPanel>
    </Grid>
</Window>
