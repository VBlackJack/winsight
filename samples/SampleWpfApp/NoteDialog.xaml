<Window x:Class="Winsight.Samples.SimpleCounter.NoteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Winsight Sample - Note"
        Width="360" Height="200"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        AutomationProperties.AutomationId="NoteDialog">
    <Grid Margin="24">
        <StackPanel>
            <TextBlock Text="Enter a note:"
                       AutomationProperties.AutomationId="NotePrompt" />
            <TextBox x:Name="NoteTextBox"
                     Margin="0,8,0,0"
                     AutomationProperties.AutomationId="NoteInput" />
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,24,0,0">
                <Button Content="OK"
                        Padding="20,6"
                        Margin="0,0,12,0"
                        IsDefault="True"
                        AutomationProperties.AutomationId="ConfirmNoteButton"
                        Click="OnConfirmClick" />
                <Button Content="Cancel"
                        Padding="20,6"
                        IsCancel="True"
                        AutomationProperties.AutomationId="CancelNoteButton" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
